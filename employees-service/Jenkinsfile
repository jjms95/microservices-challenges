pipeline {
    agent any
    environment {
        SCANNER_HOME = tool 'SonarScanner'
    }
    stages {
        stage('🏗️ Build & Install') {
            agent {
                docker {
                    image 'node:20'
                    reuseNode true
                    args '--network host'
                }
            }
            steps {
                script { currentBuild.description = "🏗️ Build & Install" }
                dir('employees-service') {
                    echo "========================================="
                    echo " 🏗️ INSTALANDO DEPENDENCIAS Y COMPILANDO"
                    echo "========================================="
                    sh 'npm install'
                    sh 'npm run build'
                }
            }
        }
        stage('🧪 Unit Tests & Coverage') {
            agent {
                docker {
                    image 'node:20'
                    reuseNode true
                    args '--network host'
                }
            }
            steps {
                script { currentBuild.description = "🧪 Unit Tests & Coverage" }
                dir('employees-service') {
                    echo "========================================="
                    echo " 🧪 EJECUTANDO PRUEBAS UNITARIAS Y COBERTURA"
                    echo "========================================="
                    sh 'npm run test:cov'
                }
            }
        }
        stage('🔍 SonarQube Analysis') {
            agent {
                docker {
                    image 'sonarsource/sonar-scanner-cli:5'
                    reuseNode true
                    args "--network host --entrypoint=''"
                }
            }
            steps {
                script { currentBuild.description = "🔍 SonarQube Analysis" }
                dir('employees-service') {
                    echo "========================================="
                    echo " 🔍 ENVIANDO ANÁLISIS A SONARQUBE"
                    echo "========================================="
                    withCredentials([string(credentialsId: 'sonar-token', variable: 'SONAR_TOKEN')]) {
                        withSonarQubeEnv('SonarQube') {
                            sh "sonar-scanner -Dsonar.token=\$SONAR_TOKEN"
                        }
                    }
                }
            }
        }
        stage('🛡️ Quality Gate') {
            steps {
                script { currentBuild.description = "🛡️ Quality Gate" }
                echo "========================================="
                echo " 🛡️ ESPERANDO RESULTADO DEL QUALITY GATE"
                echo "========================================="
                timeout(time: 5, unit: 'MINUTES') {
                    waitForQualityGate abortPipeline: true
                }
            }
        }
        stage('📦 Docker Package') {
            steps {
                script { currentBuild.description = "📦 Docker Package" }
                dir('employees-service') {
                    echo "========================================="
                    echo " 📦 CONSTRUYENDO Y SUBIENDO IMAGEN DOCKER"
                    echo "========================================="
                    script {
                        def imageName = "registry:5000/employees-service"
                        def imageTag = "${env.BUILD_NUMBER}"
                        sh "docker build -t ${imageName}:${imageTag} -t ${imageName}:latest ."
                        sh "docker push ${imageName}:${imageTag}"
                        sh "docker push ${imageName}:latest"
                    }
                }
            }
        }
        stage('🎭 BDD E2E Tests') {
            steps {
                script { currentBuild.description = "🎭 BDD E2E Tests" }
                echo "========================================="
                echo " 🎭 LEVANTANDO ECOSISTEMA E2E EFIMERO"
                echo "========================================="
                // Lock global: solo un pipeline puede ejecutar E2E a la vez
                // Evita conflictos de nombres de contenedores entre pipelines concurrentes
                lock('e2e-ecosystem') {
                    // Pre-cleanup: fuerza la eliminación de contenedores huérfanos por nombre
                    sh '''
                    docker compose --profile bdd down -v --remove-orphans 2>/dev/null || true
                    docker rm -f \
                        database-employees database-departments database-notifications \
                        database-profiles database-auth message-broker \
                        employees-service departments-service notifications-service \
                        profiles-service auth-service bdd-tests \
                        prometheus grafana loki promtail zipkin \
                        2>/dev/null || true
                    '''
                    sh '''
                    docker compose --profile bdd up \
                        --build \
                        --abort-on-container-exit \
                        --exit-code-from bdd-tests
                    '''
                }
            }
            post {
                always {
                    echo "========================================="
                    echo " DESTRUYENDO ECOSISTEMA E2E"
                    echo "========================================="
                    sh 'docker compose --profile bdd down -v --remove-orphans || true'
                    publishHTML(target: [
                        allowMissing: true,
                        alwaysLinkToLastBuild: true,
                        keepAll: true,
                        reportDir: 'e2e-tests/reports',
                        reportFiles: 'cucumber-report.html',
                        reportName: 'BDD E2E Report'
                    ])
                }
            }
        }
    }
    post {
        success {
            script { currentBuild.description = null }
            echo "========================================="
            echo " PIPELINE COMPLETADO CON EXITO"
            echo "========================================="
            echo "📊 SonarQube Report: http://localhost:9000/dashboard?id=employees-service"
            echo "📝 BDD E2E Report: http://localhost:8086/job/${env.JOB_NAME}/${env.BUILD_NUMBER}/BDD_20E2E_20Report/"
        }
        failure {
            echo "========================================="
            echo " PIPELINE FALLIDO"
            echo " Etapa con error: ${currentBuild.description}"
            echo "========================================="
        }
    }
}
