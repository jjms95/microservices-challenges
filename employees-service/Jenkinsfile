pipeline {
    agent any
    tools {
        nodejs 'NodeJS 20'
    }
    environment {
        SCANNER_HOME = tool 'SonarScanner'
    }
    stages {
        stage('Build') {
            steps {
                dir('employees-service') {
                    echo "Instalando dependencias y compilando..."
                    sh 'npm install'
                    sh 'npm run build'
                }
            }
        }
        stage('Test & Coverage') {
            steps {
                dir('employees-service') {
                    echo "Ejecutando pruebas y generando cobertura..."
                    sh 'npm run test:cov'
                }
            }
        }
        stage('SonarQube Analysis') {
            steps {
                dir('employees-service') {
                    withCredentials([string(credentialsId: 'sonar-token', variable: 'SONAR_TOKEN')]) {
                        withSonarQubeEnv('SonarQube') {
                            sh "SONAR_SCANNER_OPTS='-Xmx1024m' ${SCANNER_HOME}/bin/sonar-scanner -Dsonar.token=\$SONAR_TOKEN -Dsonar.javascript.node.maxspace=2048"
                        }
                    }
                }
            }
        }
        stage('Quality Gate') {
            steps {
                timeout(time: 5, unit: 'MINUTES') {
                    // Requiere que el Webhook esté configurado en SonarQube hacia Jenkins
                    waitForQualityGate abortPipeline: true
                }
            }
        }
        stage('Package') {
            steps {
                dir('employees-service') {
                    script {
                        def imageName = "localhost:5000/employees-service"
                        def imageTag = "${env.BUILD_NUMBER}"
                        sh "docker build -t ${imageName}:${imageTag} -t ${imageName}:latest ."
                        sh "docker push ${imageName}:${imageTag}"
                        sh "docker push ${imageName}:latest"
                    }
                }
            }
        }
        stage('E2E Tests') {
            environment {
                EMPLOYEES_URL = 'http://employees-service:8080'
                DEPARTMENTS_URL = 'http://departments-service:8081'
                AUTH_URL = 'http://auth-service:8085'
                NOTIFICATIONS_URL = 'http://notifications-service:8084'
                PROFILES_URL = 'http://profiles-service:8083'
            }
            steps {
                echo "Corriendo pruebas E2E contra los servicios locales..."
                dir('e2e-tests') {
                    sh 'npm install'
                    sh 'npm test'
                }
            }
            post {
                always {
                    publishHTML(target: [
                        allowMissing: true,
                        alwaysLinkToLastBuild: true,
                        keepAll: true,
                        reportDir: 'e2e-tests',
                        reportFiles: 'cucumber-report.html',
                        reportName: 'BDD E2E Report'
                    ])
                }
            }
        }
    }
    post {
        success {
            echo "✅ Pipeline completado con éxito"
        }
        failure {
            echo "❌ Pipeline fallido"
        }
    }
}
