pipeline {
    agent any
    environment {
        SCANNER_HOME = tool 'SonarScanner'
    }
    stages {
        stage('🏗️ Build & Install') {
            agent {
                docker {
                    image 'python:3.11-slim'
                    reuseNode true
                    args '--network host'
                }
            }
            steps {
                dir('notifications-service') {
                    echo "========================================="
                    echo " 🏗️ INSTALANDO DEPENDENCIAS DE PYTHON"
                    sh '''
                    python3 -m venv venv_ci
                    . venv_ci/bin/activate
                    pip install -r requirements.txt
                    '''
                }
            }
        }
        stage('🧪 Unit Tests & Coverage') {
            agent {
                docker {
                    image 'python:3.11-slim'
                    reuseNode true
                    args '--network host'
                }
            }
            steps {
                dir('notifications-service') {
                    echo "========================================="
                    echo " 🧪 EJECUTANDO PRUEBAS UNITARIAS Y COBERTURA"
                    sh '''
                    . venv_ci/bin/activate
                    pytest --cov=app --cov-report=xml
                    '''
                }
            }
        }
        stage('🔍 SonarQube Analysis') {
            agent {
                docker {
                    image 'sonarsource/sonar-scanner-cli:5'
                    reuseNode true
                    args '--network host'
                }
            }
            steps {
                dir('notifications-service') {
                    echo "========================================="
                    echo " 🔍 ENVIANDO ANÁLISIS A SONARQUBE"
                    echo "========================================="
                    withCredentials([string(credentialsId: 'sonar-token', variable: 'SONAR_TOKEN')]) {
                        withSonarQubeEnv('SonarQube') {
                            sh "sonar-scanner -Dsonar.token=\$SONAR_TOKEN"
                        }
                    }
                }
            }
        }
        stage('🛡️ Quality Gate') {
            steps {
                echo "========================================="
                echo " 🛡️ ESPERANDO RESULTADO DEL QUALITY GATE"
                echo "========================================="
                timeout(time: 5, unit: 'MINUTES') {
                    waitForQualityGate abortPipeline: true
                }
            }
        }
        stage('📦 Docker Package') {
            steps {
                dir('notifications-service') {
                    echo "========================================="
                    echo " 📦 CONSTRUYENDO Y SUBIENDO IMAGEN DOCKER"
                    echo "========================================="
                    script {
                        def imageName = "registry:5000/notifications-service"
                        def imageTag = "${env.BUILD_NUMBER}"
                        sh "docker build -t ${imageName}:${imageTag} -t ${imageName}:latest ."
                        sh "docker push ${imageName}:${imageTag}"
                        sh "docker push ${imageName}:latest"
                    }
                }
            }
        }
        stage('🎭 BDD E2E Tests') {
            agent {
                docker {
                    image 'node:20'
                    reuseNode true
                    args '--network host'
                }
            }
            environment {
                EMPLOYEES_URL = 'http://employees-service:8080'
                DEPARTMENTS_URL = 'http://departments-service:8081'
                AUTH_URL = 'http://auth-service:8085'
                NOTIFICATIONS_URL = 'http://notifications-service:8084'
                PROFILES_URL = 'http://profiles-service:8083'
            }
            steps {
                echo "========================================="
                echo " 🎭 CORRIENDO PRUEBAS E2E (CUCUMBER BDD)"
                echo "========================================="
                dir('e2e-tests') {
                    sh '''
                    npm install
                    npm test
                    '''
                }
            }
            post {
                always {
                    publishHTML(target: [
                        allowMissing: true,
                        alwaysLinkToLastBuild: true,
                        keepAll: true,
                        reportDir: 'e2e-tests',
                        reportFiles: 'cucumber-report.html',
                        reportName: 'BDD E2E Report'
                    ])
                }
            }
        }
    }
    post {
        success {
            echo "✅ Pipeline completado con éxito"
        }
        failure {
            echo "❌ Pipeline fallido"
        }
    }
}
