pipeline {
    agent any
    environment {
        SCANNER_HOME = tool 'SonarScanner'
        FAILED_STAGE = ''
    }
    stages {
        stage('🏗️ Build & Install') {
            agent {
                docker {
                    image 'python:3.11-slim'
                    reuseNode true
                    args '--network host'
                }
            }
            steps {
                script { env.FAILED_STAGE = '🏗️ Build & Install' }
                dir('notifications-service') {
                    echo "========================================="
                    echo " 🏗️ INSTALANDO DEPENDENCIAS DE PYTHON"
                    sh '''
                    python3 -m venv venv_ci
                    . venv_ci/bin/activate
                    pip install -r requirements.txt
                    '''
                }
            }
        }
        stage('🧪 Unit Tests & Coverage') {
            agent {
                docker {
                    image 'python:3.11-slim'
                    reuseNode true
                    args '--network host'
                }
            }
            steps {
                script { env.FAILED_STAGE = '🧪 Unit Tests & Coverage' }
                dir('notifications-service') {
                    echo "========================================="
                    echo " 🧪 EJECUTANDO PRUEBAS UNITARIAS Y COBERTURA"
                    sh '''
                    . venv_ci/bin/activate
                    pytest --cov=app --cov-report=xml
                    '''
                }
            }
        }
        stage('🔍 SonarQube Analysis') {
            agent {
                docker {
                    image 'sonarsource/sonar-scanner-cli:5'
                    reuseNode true
                    args '--network host'
                }
            }
            steps {
                script { env.FAILED_STAGE = '🔍 SonarQube Analysis' }
                dir('notifications-service') {
                    echo "========================================="
                    echo " 🔍 ENVIANDO ANÁLISIS A SONARQUBE"
                    echo "========================================="
                    withCredentials([string(credentialsId: 'sonar-token', variable: 'SONAR_TOKEN')]) {
                        withSonarQubeEnv('SonarQube') {
                            sh "sonar-scanner -Dsonar.token=\$SONAR_TOKEN"
                        }
                    }
                }
            }
        }
        stage('🛡️ Quality Gate') {
            steps {
                script { env.FAILED_STAGE = '🛡️ Quality Gate' }
                echo "========================================="
                echo " 🛡️ ESPERANDO RESULTADO DEL QUALITY GATE"
                echo "========================================="
                timeout(time: 5, unit: 'MINUTES') {
                    waitForQualityGate abortPipeline: true
                }
            }
        }
        stage('📦 Docker Package') {
            steps {
                script { env.FAILED_STAGE = '📦 Docker Package' }
                dir('notifications-service') {
                    echo "========================================="
                    echo " 📦 CONSTRUYENDO Y SUBIENDO IMAGEN DOCKER"
                    echo "========================================="
                    script {
                        def imageName = "registry:5000/notifications-service"
                        def imageTag = "${env.BUILD_NUMBER}"
                        sh "docker build -t ${imageName}:${imageTag} -t ${imageName}:latest ."
                        sh "docker push ${imageName}:${imageTag}"
                        sh "docker push ${imageName}:latest"
                    }
                }
            }
        }
        stage('🎭 BDD E2E Tests') {
            steps {
                script { env.FAILED_STAGE = '🎭 BDD E2E Tests' }
                echo "========================================="
                echo " 🎭 LEVANTANDO ECOSISTEMA E2E EFÍMERO"
                echo "========================================="
                // Levanta TODO el ecosistema (BDs + RabbitMQ + microservicios + bdd-tests)
                // --build: construye con el código más reciente del workspace
                // --abort-on-container-exit: cuando bdd-tests termina, detiene el resto
                // --exit-code-from bdd-tests: el pipeline hereda el resultado de los tests
                sh '''
                docker compose --profile bdd up \
                    --build \
                    --progress=quiet \
                    --abort-on-container-exit \
                    --exit-code-from bdd-tests
                '''
            }
            post {
                always {
                    echo "========================================="
                    echo " 🧹 DESTRUYENDO ECOSISTEMA E2E"
                    echo "========================================="
                    // Destruye contenedores + volúmenes para dejar entorno limpio
                    sh 'docker compose --profile bdd down -v --remove-orphans || true'
                    publishHTML(target: [
                        allowMissing: true,
                        alwaysLinkToLastBuild: true,
                        keepAll: true,
                        reportDir: 'e2e-tests',
                        reportFiles: 'cucumber-report.html',
                        reportName: 'BDD E2E Report'
                    ])
                }
            }
        }
    }
    post {
        success {
            echo "========================================="
            echo " ✅ PIPELINE COMPLETADO CON ÉXITO"
            echo "========================================="
        }
        failure {
            echo "========================================="
            echo " ❌ PIPELINE FALLIDO"
            echo " 📍 Etapa con error: ${env.FAILED_STAGE}"
            echo "========================================="
        }
    }
}
