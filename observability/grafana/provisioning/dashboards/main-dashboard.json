{
  "title": "Microservices Observability",
  "panels": [
    {
      "type": "stat",
      "title": "Service Status",
      "targets": [{"expr": "up", "refId": "A"}],
      "gridPos": {"h": 8, "w": 24, "x": 0, "y": 0}
    },
    {
      "type": "timeseries",
      "title": "Request Rate",
      "targets": [{"expr": "rate(http_requests_total[1m])", "refId": "A"}],
      "gridPos": {"h": 8, "w": 8, "x": 0, "y": 8}
    },
    {
      "type": "timeseries",
      "title": "Latency",
      "targets": [{"expr": "rate(http_request_duration_seconds_sum[1m]) / rate(http_request_duration_seconds_count[1m])", "refId": "A"}],
      "gridPos": {"h": 8, "w": 8, "x": 8, "y": 8}
    },
    {
      "type": "timeseries",
      "title": "Error Rate",
      "targets": [{"expr": "sum by (status) (rate(http_requests_total{status=~\"[45]..\"}[1m]))", "refId": "A"}],
      "gridPos": {"h": 8, "w": 8, "x": 16, "y": 8}
    }
  ],
  "schemaVersion": 38,
  "timezone": "browser"
}
